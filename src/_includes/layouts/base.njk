<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {%- set pageTitle = title | default(false) -%}
  {%- set fullTitle = (pageTitle + " · Rohi Schools") if pageTitle else "Rohi Schools · Excellence in Learning and Character" -%}
  {%- set pageDesc = description | default(site.school.description) -%}
  {%- set pageUrl = site.url + (page.url | default("/")) -%}
  {%- set shareImage = site.url + site.school.ogImage -%}

  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#590694">
  <title>{{ fullTitle }}</title>
  <link rel="canonical" href="{{ pageUrl }}">

  <!-- Open Graph. Most of this school's traffic arrives via WhatsApp shares,
       which read og:title / og:description / og:image and nothing else. -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.school.name }}">
  <meta property="og:locale" content="en_NG">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ shareImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ site.school.name }} — {{ site.school.tagline }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ shareImage }}">

  <!-- Favicons. .ico carries 16/32/48 for tabs and bookmarks; the apple icon
       is drawn on white because iOS composites transparency onto black. -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/icons/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/icons/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=2" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "@id": "{{ site.url }}/#school",
    "name": "{{ site.school.name }}",
    "alternateName": "{{ site.school.shortName }}",
    "url": "{{ site.url }}/",
    "logo": "{{ site.url }}/img/icons/icon-512.png",
    "image": "{{ shareImage }}",
    "description": "{{ site.school.description }}",
    "foundingDate": "{{ site.school.founded }}",
    "email": "{{ site.school.email }}",
    "telephone": "{{ site.school.phone[0] }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.school.street }}",
      "addressLocality": "{{ site.school.city }}",
      "addressRegion": "{{ site.school.region }}",
      "addressCountry": "{{ site.school.country }}"
    },
    "sameAs": ["{{ site.school.facebook }}"]
  }
  </script>
</head>

<body class="{% if hasHero %}has-hero{% endif %}">

  <a href="#main" class="visually-hidden-focusable">Skip to content</a>

  <nav class="site-nav" id="siteNav">
    <div class="nav-inner">
      <a class="nav-brand" href="/">
        <img src="/img/rohilo.jpg" alt="" />
        <span class="nav-brand-text">
          <span class="nav-brand-name">Rohi Schools</span>
          <span class="nav-brand-sub">Abeokuta, Ogun</span>
        </span>
      </a>

      <ul class="nav-links">
        <li><a href="/" class="{% if page.url == '/' %}is-active{% endif %}">Home</a></li>
        <li><a href="/about/" class="{% if '/about/' in page.url %}is-active{% endif %}">About</a></li>
        <li><a href="/news/" class="{% if '/news' in page.url %}is-active{% endif %}">News</a></li>
        <li><a href="/contact/" class="{% if '/contact/' in page.url %}is-active{% endif %}">Contact</a></li>
      </ul>

      <div class="nav-cta">
        <a href="/portal.html" class="btn-primary-solid"><i class="bi bi-box-arrow-in-right"></i> Portal</a>
      </div>

      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
        <i class="bi bi-list"></i>
      </button>
    </div>
  </nav>

  <div class="nav-scrim" id="navScrim"></div>
  <aside class="nav-panel" id="navPanel" aria-label="Menu">
    <div class="nav-panel-head">
      <span class="nav-brand">
        <img src="/img/rohilo.jpg" alt="" />
        <span class="nav-brand-text">
          <span class="nav-brand-name" style="color:var(--ink)">Rohi Schools</span>
          <span class="nav-brand-sub" style="color:var(--muted)">Abeokuta, Ogun</span>
        </span>
      </span>
      <button class="nav-panel-close" id="navClose" aria-label="Close menu"><i class="bi bi-x-lg"></i></button>
    </div>
    <a href="/" class="panel-link {% if page.url == '/' %}is-active{% endif %}">Home <i class="bi bi-chevron-right"></i></a>
    <a href="/about/" class="panel-link {% if '/about/' in page.url %}is-active{% endif %}">About <i class="bi bi-chevron-right"></i></a>
    <a href="/news/" class="panel-link {% if '/news' in page.url %}is-active{% endif %}">News <i class="bi bi-chevron-right"></i></a>
    <a href="/contact/" class="panel-link {% if '/contact/' in page.url %}is-active{% endif %}">Contact <i class="bi bi-chevron-right"></i></a>
    <a href="/portal.html" class="btn-primary-solid"><i class="bi bi-box-arrow-in-right"></i> Open Portal</a>
  </aside>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-accent" aria-hidden="true"></div>

    <div class="container-wide">
      <div class="footer-top">
        <div class="footer-identity">
          <div class="footer-brand">
            <img src="/img/rohilo.jpg" alt="" />
            <div>
              <span class="footer-brand-name">Rohi Group of Schools</span>
              <span class="footer-brand-sub">Abeokuta, Ogun State</span>
            </div>
          </div>
          <p class="footer-tagline">Raising principled leaders through sound education — Kindergarten through Senior Secondary, across two campuses.</p>
          <div class="footer-socials">
            <a href="https://www.facebook.com/profile.php?id=100063597926687" aria-label="Facebook on Facebook"><i class="bi bi-facebook"></i></a>
            <a href="https://wa.me/2347031362416" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><i class="bi bi-whatsapp"></i></a>
            <a href="mailto:rohicollegeogunradio@gmail.com" aria-label="Email the school"><i class="bi bi-envelope-fill"></i></a>
          </div>
        </div>

        <nav class="footer-col" aria-label="Explore">
          <h6>Explore</h6>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about/">About us</a></li>
            <li><a href="/news/">News &amp; updates</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </nav>

        <nav class="footer-col" aria-label="Programmes">
          <h6>Programmes</h6>
          <ul>
            <li><a href="/about/#programmes">Pre-KG &amp; Kindergarten</a></li>
            <li><a href="/about/#programmes">Nursery</a></li>
            <li><a href="/about/#programmes">Primary</a></li>
            <li><a href="/about/#programmes">Junior Secondary</a></li>
            <li><a href="/about/#programmes">Senior Secondary</a></li>
          </ul>
        </nav>

        <div class="footer-col footer-contact-col">
          <h6>Visit or call</h6>
          <ul class="footer-contact">
            <li>
              <i class="bi bi-geo-alt-fill"></i>
              <span>Adjacent Wise Hotel, New Range,<br>Ogun Radio, Abeokuta, Ogun State</span>
            </li>
            <li>
              <i class="bi bi-telephone-fill"></i>
              <span><a href="tel:+2348032408415">+234 803 240 8415</a><br><a href="tel:+2347031362416">+234 703 136 2416</a></span>
            </li>
            <li>
              <i class="bi bi-envelope-fill"></i>
              <span><a href="mailto:rohicollegeogunradio@gmail.com">rohicollegeogunradio@gmail.com</a></span>
            </li>
          </ul>
          <a href="/portal.html" class="footer-portal-btn"><i class="bi bi-box-arrow-in-right"></i> Student &amp; staff portal</a>
        </div>
      </div>

      <div class="footer-base">
        <span>&copy; <span id="year"></span> Rohi Group of Schools. All rights reserved.</span>
        <span class="footer-credit">Built by <strong>Brillytech Networks</strong></span>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Nav solidifies once you leave the hero, so it never sits invisible over
    // imagery or opaque over nothing.
    (function () {
      var nav = document.getElementById('siteNav');
      var hasHero = document.body.classList.contains('has-hero');
      function onScroll() {
        if (!hasHero) return;
        nav.classList.toggle('is-solid', window.scrollY > 40);
      }
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      var panel = document.getElementById('navPanel');
      var scrim = document.getElementById('navScrim');
      var toggle = document.getElementById('navToggle');
      function setOpen(open) {
        panel.classList.toggle('open', open);
        scrim.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
      }
      toggle.addEventListener('click', function () { setOpen(true); });
      document.getElementById('navClose').addEventListener('click', function () { setOpen(false); });
      scrim.addEventListener('click', function () { setOpen(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

      var y = document.getElementById('year');
      if (y) y.textContent = new Date().getFullYear();
    })();
  </script>
  <script src="/js/reveal.js" defer></script>
</body>
</html>
