---
layout: layouts/base.njk
---

<article class="post-page">
  <header class="post-header">
    <div class="container-narrow">
      <a href="/news/" class="back-link"><i class="bi bi-arrow-left"></i> All news</a>
      <span class="chip chip-{{ post.category | lower }}">{{ post.category }}</span>
      <h1>{{ post.title }}</h1>
      <p class="post-meta">
        <time datetime="{{ post.publish_at }}">{{ post.dateObj | date("MMMM dd, yyyy") }}</time>
      </p>
    </div>
  </header>

  {% if post.coverUrl %}
    <div class="container-narrow">
      <img src="{{ post.coverUrl }}" alt="{{ post.cover_image_alt or post.title }}"
           class="post-cover" loading="eager" />
    </div>
  {% endif %}

  <div class="container-narrow">
    <div class="prose">
      {{ post.body_html | safe }}
    </div>

    <nav class="post-nav">
      <a href="/news/" class="btn-ghost"><i class="bi bi-arrow-left"></i> Back to all news</a>
      <a href="/contact/" class="btn-primary-solid">Get in touch</a>
    </nav>
  </div>
</article>
